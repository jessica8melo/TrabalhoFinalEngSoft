<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<h1>Avaliação — <%= @turma.classCode %></h1>

<%= form_with url: responder_avaliacao_path(@turma), method: :post, local: true do |f| %>
  <% @questions.each do |question| %>
    <div class="questao">
      <p>
        <strong><%= question.text %></strong>
        <% if question.obrigatoria? %><span class="obrigatoria">*</span><% end %>
      </p>

      <% if question.kind == "radio" %>
        <% ["Sim", "Não", "Parcialmente"].each do |opcao| %>
          <label>
            <input type="radio" name="answers[<%= question.id %>]" value="<%= opcao %>">
            <%= opcao %>
          </label>
        <% end %>
      <% else %>
        <textarea name="answers[<%= question.id %>]" rows="3"></textarea>
      <% end %>
    </div>
  <% end %>

  <button type="submit" class="btn-enviar-formulario btn btn-primary">Enviar Avaliação</button>
<% end %>
