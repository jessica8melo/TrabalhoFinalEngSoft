<body>
    <% if flash[:notice] || flash[:alert] %>
        <div class="modal-overlay">
            <div class="modal">
                 <p class="<%= flash[:notice] ? 'notice' : 'flash-alert' %>">
                    <%= flash[:notice] || flash[:alert] %>
                </p>
                <script>
                  setTimeout(() => {
                    const modal = document.querySelector('.modal-overlay');
                    if (modal) modal.remove();
                  }, 3000);
                </script>
            </div>
        </div>

        <% if flash[:notice] %>
            <script>
                setTimeout(() => {window.location.href = "<%= home_path %>";}, 1500);
            </script>
        <% end %>
    <% end %>

    <div class="login-wrapper">
        <div class="login-left">
            <h1>LOGIN</h1>

            <%= form_with url: login_path do |form| %>
                <div class="field">
                    <%= form.label :login, "Email ou Matrícula" %>
                    <%= form.text_field :login, required: true, placeholder: "Email ou Matrícula" %>
                </div>
                <div class="field">
                    <%= form.label :password, "Senha" %>
                    <%= form.password_field :password, required: true, placeholder: "Senha" %>
                </div>
                <%= form.submit "Entrar" %>
            <% end %>
        </div>

        <div class="login-right">
            <h2>Bem-vindo ao Camaar</h2>
        </div>
    </div>
</body>